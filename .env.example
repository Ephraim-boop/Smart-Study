# Copy to .env and fill in. Never commit .env.
# Only the anon (public) key belongs in the browser. Do NOT put the service-role
# key here — it must stay on the server (e.g. in Supabase Edge Functions).
#
# Both values are REQUIRED for real sign-up / log-in. If either is missing the
# app shows a "not configured" setup screen and will NOT fake a login.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Smart Summarize (AI) -------------------------------------------------
# Route summarize calls to the LOCAL secure dev server (run `npm run summarize`).
# Set this to the server URL; delete it to use the Supabase Edge Function instead.
VITE_SUMMARIZE_ENDPOINT=http://localhost:8787/summarize

# The AI API key is NEVER a browser env var. For the local server it goes in
# server/.env (GEMINI_API_KEY or OPENAI_API_KEY); for production it is a Supabase
# secret (supabase secrets set OPENAI_API_KEY=sk-...). Never add a real AI key
# to this file. See SETUP.md -> Smart Summarize.
