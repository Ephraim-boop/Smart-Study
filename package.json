{
  "name": "studysmart-subscription-module",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "StudySmart subscription, pricing, and Orange Money payment-verification module (React + TypeScript + Tailwind + Supabase).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --host",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/dev.mjs preview",
    "summarize": "node server/summarizeServer.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "jspdf": "^4.2.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.5.136",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
