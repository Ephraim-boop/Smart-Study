# Smart Summarize LOCAL backend config. Copy to server/.env and fill in ONE key.
# This file is server-side only and is gitignored — the key NEVER reaches the browser.

# Which provider to use: "gemini" (free, recommended) or "openai"
AI_PROVIDER=gemini

# --- Google Gemini (get a free key at https://aistudio.google.com) --------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- OpenAI (alternative; get a key at https://platform.openai.com) -------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Port the local summarize server listens on (must match VITE_SUMMARIZE_ENDPOINT)
PORT=8787
